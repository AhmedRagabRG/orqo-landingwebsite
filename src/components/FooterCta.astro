---
/** Short closing call to action at the top of the footer. */
import { site } from '../config/site';
---
<div class="fcta">
  <div class="fcta-copy">
    <h2 class="fcta-t">جاهز تبدأ مع <span lang="en">ORQO</span>؟</h2>
    <p>الخطة المجانية دائمة، وبدون بطاقة دفع.</p>
  </div>
  <div class="fcta-btns">
    <a class="btn btn-mint" href={site.signupUrl}>ابدأ مجانًا <svg aria-hidden="true"><use href="#i-arrow" /></svg></a>
    <a class="btn btn-ghost-deep" href="/contact">احجز عرضًا توضيحيًا</a>
  </div>
</div>
