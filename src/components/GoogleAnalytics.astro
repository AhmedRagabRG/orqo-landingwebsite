---
import { site } from '../config/site';

// Renders nothing until a GA4 measurement ID is configured (e.g. G-XXXXXXXXXX).
// gtag.js is injected after the window load event so it never competes with the
// critical rendering path on slow connections.
const { gaId = site.gaId } = Astro.props;
---
{gaId && (
  <script is:inline define:vars={{ gaId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', gaId);

    var loadGtag = function () {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
    };
    if (document.readyState === 'complete') { loadGtag(); } else { window.addEventListener('load', loadGtag); }
  </script>
)}
