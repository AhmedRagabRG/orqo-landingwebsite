---
import { I } from '../i18n';
const { t } = I(Astro);
---
<button class="review-toggle" type="button" aria-pressed="true" title={t.reviewToggle.title}>
  <span class="rtg-dot" aria-hidden="true"></span><span class="rtg-on">{t.reviewToggle.on}</span><span class="rtg-off">{t.reviewToggle.off}</span>
</button>
