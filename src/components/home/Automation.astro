---
import { I } from '../../i18n';
import SectionHead from '../ui/SectionHead.astro';
const { t } = I(Astro);
const p = t.automation;
const f = p.flow;
---
<section class="sec automation" id="automation" aria-labelledby="auto-title">
  <div class="wrap auto-grid">
    <div class="auto-copy">
      <SectionHead id="auto-title" layout="start" chip={p.chip} icon="i-bolt" title={p.title} accent={p.accent} lead={p.lead} />
      <dl class="outcomes">
        {p.outcomes.map((o) => <div><dt>{o.dt}</dt><dd>{o.dd}</dd></div>)}
      </dl>
      <p class="triggers"><span>{p.triggersLabel}</span> {p.triggers}</p>
    </div>

    <figure class="flow" aria-label={p.flowAria}>
      <svg class="flow-lines" viewBox="0 0 520 600" preserveAspectRatio="none" aria-hidden="true">
        <path d="M260 78 V 150"/>
        <path d="M260 214 C 260 250, 140 240, 140 282"/>
        <path d="M260 214 C 260 250, 380 240, 380 282"/>
        <path d="M140 346 C 140 390, 260 380, 260 420"/>
        <path d="M380 346 C 380 390, 260 380, 260 420"/>
        <path d="M260 484 V 520"/>
      </svg>
      <div class="fnode fn-trigger" style="--x:50%;--y:2%;--d:0"><span class="fi"><svg aria-hidden="true"><use href="#i-bolt"/></svg></span><span><small>{f.trigger.s}</small><b>{f.trigger.b}</b></span></div>
      <div class="fnode fn-cond" style="--x:50%;--y:25%;--d:1"><span class="fi"><svg aria-hidden="true"><use href="#i-split"/></svg></span><span><small>{f.cond.s}</small><b>{f.cond.b}</b></span></div>
      <span class="fyes" style="--x:27%;--y:41%">{f.yes}</span><span class="fno" style="--x:73%;--y:41%">{f.no}</span>
      <div class="fnode fn-ai" style="--x:27%;--y:47%;--d:2"><span class="fi"><svg aria-hidden="true"><use href="#i-bot"/></svg></span><span><small>{f.ai.s}</small><b>{f.ai.b}</b></span></div>
      <div class="fnode fn-assign" style="--x:73%;--y:47%;--d:2"><span class="fi"><svg aria-hidden="true"><use href="#i-user"/></svg></span><span><small>{f.assign.s}</small><b>{f.assign.b}</b></span></div>
      <div class="fnode fn-wait" style="--x:50%;--y:70%;--d:3"><span class="fi"><svg aria-hidden="true"><use href="#i-clock"/></svg></span><span><small>{f.wait.s}</small><b>{f.wait.b}</b></span></div>
      <div class="fnode fn-send" style="--x:50%;--y:87%;--d:4"><span class="fi wa"><svg aria-hidden="true"><use href="#i-wa"/></svg></span><span><small>{f.send.s}</small><b>{f.send.b}</b></span></div>
      <figcaption class="review-tag">{p.review}</figcaption>
    </figure>
  </div>
</section>
