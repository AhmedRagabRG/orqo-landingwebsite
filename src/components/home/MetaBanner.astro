---
const facts = [
  { n: '3', t: 'قنوات في صندوق وارد واحد' },
  { n: '24/7', t: 'وكيل ذكي يرد على عملائك' },
  { n: '10+', t: 'تكاملات جاهزة و API' },
  { n: '0$', t: 'للبدء، بدون بطاقة دفع' },
];
---
<section class="facts-sec" aria-label="ORQO باختصار">
  <div class="wrap">
    <ul class="facts">
      {facts.map((f) => <li><b>{f.n}</b><span>{f.t}</span></li>)}
    </ul>
    <div class="meta-banner">
      <svg class="mb-big" aria-hidden="true"><use href="#i-meta" /></svg>
      <div class="mb-txt">
        <p class="mb-h"><span lang="en">Meta Tech Provider</span></p>
        <p class="mb-s">مزوّد تقني مسجّل لدى Meta</p>
        <p class="mb-p">ربط رسمي لرقم واتساب أعمالك وحسابات إنستجرام وماسنجر، بدون حلول غير رسمية.</p>
      </div>
    </div>
  </div>
</section>
