---
import { site } from '../../config/site';
import { faq } from '../../data/faq';
import SectionHead from '../ui/SectionHead.astro';
---
<section class="sec faqx" id="faq" aria-labelledby="faq-title">
  <div class="wrap faqx-inner">
    <SectionHead id="faq-title" chip="الأسئلة الشائعة" icon="i-note" title="أسئلة قبل البداية" />
    <div class="faqx-tabs" role="tablist" aria-label="موضوعات الأسئلة">
      {faq.map((g, i) => (
        <button type="button" role="tab" id={`faqt-${g.id}`} aria-controls={`faqp-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{g.label}</button>
      ))}
    </div>
    {faq.map((g, i) => (
      <div class="faqx-panel" role="tabpanel" id={`faqp-${g.id}`} aria-labelledby={`faqt-${g.id}`} hidden={i !== 0}>
        {g.items.map((it, j) => (
          <details class="faqx-item" name={`faq-${g.id}`} open={i === 0 && j === 0}>
            <summary>{it.q}<svg aria-hidden="true"><use href="#i-chev" /></svg></summary>
            <p>{it.a}</p>
          </details>
        ))}
      </div>
    ))}
    <div class="faqx-ask">
      <p><b>عندك سؤال آخر؟</b> يسعدنا نرد عليك على واتساب.</p>
      <a class="btn btn-wa btn-sm" href={site.whatsappUrl}><svg aria-hidden="true"><use href="#i-wa" /></svg>تواصل معنا على واتساب</a>
    </div>
  </div>
</section>
