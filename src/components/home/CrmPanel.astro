---
import SectionHead from '../ui/SectionHead.astro';
import CtaPair from '../ui/CtaPair.astro';
---
<section class="panel-dark crm-panel" id="contacts" aria-labelledby="crm-title">
  <div class="wrap">
    <SectionHead id="crm-title" tone="dark" chip="جهات الاتصال و CRM" icon="i-user" title="من أول رسالة إلى ملف عميل كامل." accent="كل شيء عن عميلك في مكان واحد." lead="كل من يراسلك على أي قناة يصبح جهة اتصال تلقائيًا، ومعه بياناته ووسومه وملاحظاته وطلباته." />
    <ul class="dcards">
      <li class="dcard"><svg aria-hidden="true"><use href="#i-user" /></svg><b>ملف عميل كامل</b><span>كل بياناته ومحادثاته من كل القنوات في مكان واحد.</span></li>
      <li class="dcard"><svg aria-hidden="true"><use href="#i-list" /></svg><b>حقول مخصصة</b><span>المدينة، الميزانية، نوع الخدمة، أو أي حقل يحتاجه عملك.</span></li>
      <li class="dcard"><svg aria-hidden="true"><use href="#i-tag" /></svg><b>الوسوم والشرائح</b><span>صنّف عملاءك وابنِ شرائح بشروط للحملات والأتمتة.</span></li>
      <li class="dcard"><svg aria-hidden="true"><use href="#i-note" /></svg><b>الملاحظات الداخلية</b><span>كل ما يعرفه فريقك عن العميل يبقى محفوظًا.</span></li>
      <li class="dcard"><svg aria-hidden="true"><use href="#i-clock" /></svg><b>النشاط والسجل</b><span>كل تغيير ومحادثة ومرحلة في سجل واحد.</span></li>
      <li class="dcard"><svg aria-hidden="true"><use href="#i-cart" /></svg><b>طلبات المتجر</b><span>طلبات Shopify و WooCommerce و EasyOrders في ملف العميل.</span></li>
      <li class="dcard"><svg aria-hidden="true"><use href="#i-layers" /></svg><b>مراحل العملاء</b><span>من أول استفسار حتى الحجز أو البيع.</span></li>
      <li class="dcard"><svg aria-hidden="true"><use href="#i-copy" /></svg><b>استيراد وتصدير</b><span>انقل عملاءك من CSV و Excel في دقائق.</span></li>
    </ul>
    <CtaPair tone="dark" />
    <div class="crm-show">
    <div class="crmx" aria-label="مثال لقائمة جهات الاتصال والشرائح وملف عميل">
      <aside class="crm-seg" aria-hidden="true">
        <p class="cs-h">الشرائح</p>
        <p class="sg"><span>كل جهات الاتصال</span><b>2,418</b></p>
        <p class="sg on"><span>عملاء مهتمون</span><b>312</b></p>
        <p class="sg"><span>VIP</span><b>48</b></p>
        <p class="sg"><span>لم يتواصلوا منذ 30 يومًا</span><b>506</b></p>
        <p class="sg"><span>عملاء المتجر</span><b>1,120</b></p>
        <p class="sg sg-new"><svg><use href="#i-plus"/></svg>شريحة جديدة</p>
        <p class="sg-imp"><svg><use href="#i-list"/></svg>استيراد من CSV أو Excel</p>
      </aside>
      <div class="crm-table" aria-hidden="true">
        <div class="ct-bar">
          <span class="ct-search">ابحث بالاسم أو الرقم أو الوسم</span>
          <span class="ct-filter">الوسم: عميل مهتم <i>×</i></span>
          <span class="ct-filter">القناة: الكل</span>
        </div>
        <div class="ct-scroll"><table>
          <thead><tr><th>الاسم</th><th>الهاتف</th><th>الوسوم</th><th>المرحلة</th><th>آخر تواصل</th></tr></thead>
          <tbody><tr class="is-sel"><td><span class="ct-name"><span class="ct-av">م<svg class="c-wa"><use href="#i-wa"/></svg></span>منى عادل</span></td><td dir="ltr" class="ct-ph">+20 10 ··· 0000</td><td class="ct-tags"><i>عميل مهتم</i></td><td><span class="ct-stage">Booked</span></td><td class="ct-last">اليوم</td></tr><tr><td><span class="ct-name"><span class="ct-av">أ<svg class="c-wa"><use href="#i-wa"/></svg></span>أحمد سامي</span></td><td dir="ltr" class="ct-ph">+20 10 ··· 4567</td><td class="ct-tags"><i>VIP</i><i>عميل المتجر</i></td><td><span class="ct-stage">Qualified</span></td><td class="ct-last">أمس</td></tr><tr><td><span class="ct-name"><span class="ct-av">س<svg class="c-ig"><use href="#i-ig"/></svg></span>سلمى حسن</span></td><td dir="ltr" class="ct-ph">+20 11 ··· 2104</td><td class="ct-tags"><i>عميل مهتم</i></td><td><span class="ct-stage">جديد</span></td><td class="ct-last">منذ 3 أيام</td></tr><tr><td><span class="ct-name"><span class="ct-av">ك<svg class="c-ms"><use href="#i-ms"/></svg></span>كريم منصور</span></td><td dir="ltr" class="ct-ph">+966 5 ··· 8841</td><td class="ct-tags"><i>سفر</i></td><td><span class="ct-stage">عرض سعر</span></td><td class="ct-last">منذ أسبوع</td></tr><tr><td><span class="ct-name"><span class="ct-av">د<svg class="c-wa"><use href="#i-wa"/></svg></span>دعاء شريف</span></td><td dir="ltr" class="ct-ph">+20 12 ··· 3390</td><td class="ct-tags"><i>عميل المتجر</i></td><td><span class="ct-stage">—</span></td><td class="ct-last">منذ 34 يومًا</td></tr><tr><td><span class="ct-name"><span class="ct-av">ع<svg class="c-ig"><use href="#i-ig"/></svg></span>عمر نبيل</span></td><td dir="ltr" class="ct-ph">+20 10 ··· 7712</td><td class="ct-tags"></td><td><span class="ct-stage">جديد</span></td><td class="ct-last">منذ 41 يومًا</td></tr></tbody>
        </table></div>
      </div>
      <div class="pi crm-pi" aria-hidden="true">
          <div class="pi-head"><span class="pi-av">م<svg class="c-wa"><use href="#i-wa"/></svg></span><span class="pi-who"><b>منى عادل</b><small dir="ltr">+20 000 000 0000</small></span><span class="pi-stage">Booked ✅</span></div>
          <div class="pi-tabs"><i class="on">التفاصيل</i><i>النشاط</i><i>الطلبات</i><i>الوسائط</i></div>
          <dl class="pi-fields">
            <div><dt>الاسم</dt><dd>منى عادل</dd><span class="src src-ai">سجّله AI</span></div>
            <div><dt>المصدر</dt><dd>WhatsApp</dd><span class="src">تلقائي</span></div>
            <div><dt>الاهتمام</dt><dd>استشارة</dd><span class="src">حقل مخصص</span></div>
            <div><dt>الوقت المفضل</dt><dd>الخميس بعد 6 م</dd><span class="src">حقل مخصص</span></div>
          </dl>
          <p class="pi-tags"><i>عميل مهتم</i><i>استشارات</i><i class="ghost">+ وسم</i></p>
          <div class="pi-note"><b><svg><use href="#i-note"/></svg>ملاحظة داخلية</b>تفضل التواصل على واتساب بعد 6 مساءً.</div>
        </div>
      <span class="demo-flag">أرقام مثال</span>
    </div>

    </div>
  </div>
</section>
