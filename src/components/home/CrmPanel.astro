---
import { I } from '../../i18n';
import SectionHead from '../ui/SectionHead.astro';
const { t } = I(Astro);
const p = t.crm;
const x = p.crmx;
const m = t.mock;
---
<section class="panel-dark crm-panel" id="contacts" aria-labelledby="crm-title">
  <div class="wrap">
    <SectionHead id="crm-title" tone="dark" chip={p.chip} icon="i-user" title={p.title} accent={p.accent} lead={p.lead} />
    <ul class="dcards">
      {p.dcards.map((d, i) => (
        <li class="dcard"><svg aria-hidden="true"><use href={['#i-user', '#i-list', '#i-tag', '#i-note', '#i-clock', '#i-cart', '#i-layers', '#i-copy'][i]} /></svg><b>{d.b}</b><span>{d.s}</span></li>
      ))}
    </ul>
    <div class="crm-show">
    <div class="crmx" aria-label={x.aria}>
      <aside class="crm-seg" aria-hidden="true">
        <p class="cs-h">{x.segTitle}</p>
        <p class="sg"><span>{x.segs[0]}</span><b>2,418</b></p>
        <p class="sg on"><span>{x.segs[1]}</span><b>312</b></p>
        <p class="sg"><span>{x.segs[2]}</span><b>48</b></p>
        <p class="sg"><span>{x.segs[3]}</span><b>506</b></p>
        <p class="sg"><span>{x.segs[4]}</span><b>1,120</b></p>
        <p class="sg sg-new"><svg><use href="#i-plus"/></svg>{x.segNew}</p>
        <p class="sg-imp"><svg><use href="#i-list"/></svg>{x.segImport}</p>
      </aside>
      <div class="crm-table" aria-hidden="true">
        <div class="ct-bar">
          <span class="ct-search">{x.search}</span>
          <span class="ct-filter">{x.filterTag} <i>×</i></span>
          <span class="ct-filter">{x.filterChan}</span>
        </div>
        <div class="ct-scroll"><table>
          <thead><tr>{x.cols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>
            <tr class="is-sel"><td><span class="ct-name"><span class="ct-av">{m.monaInitial}<svg class="c-wa"><use href="#i-wa"/></svg></span>{m.mona}</span></td><td dir="ltr" class="ct-ph">{m.phones[0]}</td><td class="ct-tags"><i>{x.tags[0]}</i></td><td><span class="ct-stage" lang="en">{x.stages[0]}</span></td><td class="ct-last">{x.lastSeen[0]}</td></tr>
            <tr><td><span class="ct-name"><span class="ct-av">{m.ahmedInitial}<svg class="c-wa"><use href="#i-wa"/></svg></span>{m.ahmedSamy}</span></td><td dir="ltr" class="ct-ph">{m.phones[1]}</td><td class="ct-tags"><i>{x.tags[1]}</i><i>{x.tags[2]}</i></td><td><span class="ct-stage" lang="en">{x.stages[1]}</span></td><td class="ct-last">{x.lastSeen[1]}</td></tr>
            <tr><td><span class="ct-name"><span class="ct-av">{m.salmaInitial}<svg class="c-ig"><use href="#i-ig"/></svg></span>{m.salma}</span></td><td dir="ltr" class="ct-ph">{m.phones[2]}</td><td class="ct-tags"><i>{x.tags[0]}</i></td><td><span class="ct-stage">{x.stages[2]}</span></td><td class="ct-last">{x.lastSeen[2]}</td></tr>
            <tr><td><span class="ct-name"><span class="ct-av">{m.karimInitial}<svg class="c-ms"><use href="#i-ms"/></svg></span>{m.karim}</span></td><td dir="ltr" class="ct-ph">{m.phones[3]}</td><td class="ct-tags"><i>{x.tags[3]}</i></td><td><span class="ct-stage">{x.stages[3]}</span></td><td class="ct-last">{x.lastSeen[3]}</td></tr>
            <tr><td><span class="ct-name"><span class="ct-av">{m.doaaInitial}<svg class="c-wa"><use href="#i-wa"/></svg></span>{m.doaa}</span></td><td dir="ltr" class="ct-ph">{m.phones[4]}</td><td class="ct-tags"><i>{x.tags[2]}</i></td><td><span class="ct-stage">{x.stages[4]}</span></td><td class="ct-last">{x.lastSeen[4]}</td></tr>
            <tr><td><span class="ct-name"><span class="ct-av">{m.omarInitial}<svg class="c-ig"><use href="#i-ig"/></svg></span>{m.omar}</span></td><td dir="ltr" class="ct-ph">{m.phones[5]}</td><td class="ct-tags"></td><td><span class="ct-stage">{x.stages[2]}</span></td><td class="ct-last">{x.lastSeen[5]}</td></tr>
          </tbody>
        </table></div>
      </div>
      <div class="pi crm-pi" aria-hidden="true">
          <div class="pi-head"><span class="pi-av">{m.monaInitial}<svg class="c-wa"><use href="#i-wa"/></svg></span><span class="pi-who"><b>{m.mona}</b><small dir="ltr">+20 000 000 0000</small></span><span class="pi-stage" lang="en">Booked ✅</span></div>
          <div class="pi-tabs">{x.piTabs.map((tab, i) => <i class={i === 0 ? 'on' : undefined}>{tab}</i>)}</div>
          <dl class="pi-fields">
            {x.piFields.map((f, i) => (
              <div><dt>{f.dt}</dt><dd>{f.dd}</dd><span class:list={['src', { 'src-ai': i === 0 }]}>{f.src}</span></div>
            ))}
          </dl>
          <p class="pi-tags"><i>{x.tags[0]}</i><i>{x.consultTag}</i><i class="ghost">{x.addTag}</i></p>
          <div class="pi-note"><b><svg><use href="#i-note"/></svg>{x.noteLabel}</b>{x.noteText}</div>
        </div>
      <span class="demo-flag">{x.demoFlag}</span>
    </div>

    </div>
  </div>
</section>
