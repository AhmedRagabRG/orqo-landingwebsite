---
import SectionHead from '../ui/SectionHead.astro';
const items = [
  { icon: 'i-med', g: 'g-mint', t: 'العيادات والمراكز الطبية', q: 'عايزة أحجز كشف يوم السبت', a: 'حجز ومواعيد وتذكيرات' },
  { icon: 'i-cap', g: 'g-sky', t: 'التعليم والتدريب', q: 'الكورس أونلاين ولا حضوري؟', a: 'استفسارات وتسجيل ومتابعة' },
  { icon: 'i-home', g: 'g-sand', t: 'العقارات', q: 'الشقة لسه متاحة؟', a: 'تأهيل العميل ومواعيد المعاينة' },
  { icon: 'i-plane', g: 'g-info', t: 'السفر والسياحة', q: 'الباقة لشخصين بكام؟', a: 'باقات وعروض أسعار' },
  { icon: 'i-cart', g: 'g-green', t: 'المتاجر الإلكترونية', q: 'الأوردر هيوصل إمتى؟', a: 'تأكيد COD وسلات متروكة' },
  { icon: 'i-headset', g: 'g-teal', t: 'الخدمات وفرق الدعم', q: 'عندي مشكلة في الخدمة', a: 'دعم وتحويل للشخص المناسب' },
];
---
<section class="sec inds" id="industries" aria-labelledby="ind-title">
  <div class="wrap">
    <SectionHead id="ind-title" chip="لمن ORQO" icon="i-layers" title="من العيادة إلى المتجر الإلكتروني." accent="كل عمل يستقبل رسائل عملاء، مكانه ORQO." />
    <ul class="ind-tiles">
      {items.map((it) => (
        <li class="indt">
          <div class:list={['indt-art', it.g]} aria-hidden="true">
            <svg class="indt-ico"><use href={`#${it.icon}`} /></svg>
            <span class="indt-q">{it.q}</span>
          </div>
          <h3>{it.t}</h3>
          <p>{it.a}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
