---
import { site } from '../../config/site';
import SectionHead from '../ui/SectionHead.astro';

const steps = [
  { t: 'اختر جمهورك', d: 'شريحة حسب الوسوم والحقول وآخر تواصل.' },
  { t: 'اختر قالبًا معتمدًا', d: 'قوالب واتساب الرسمية بمتغيرات وأزرار.' },
  { t: 'أرسل أو جدول', d: 'من رقم واتساب الأعمال المربوط.' },
  { t: 'تابع النتائج', d: 'الوصول والقراءة والنقرات والردود.' },
];
---
<section class="sec camps" id="campaigns" aria-labelledby="cb-title">
  <div class="wrap">
    <SectionHead id="cb-title" layout="split" chip="حملات واتساب" icon="i-wa" title="رسالة واحدة،" accent="تصل لكل عملائك على واتساب." lead="عروض وتذكيرات وإعلانات من رقم واتساب أعمالك، بقوالب معتمدة من Meta وبدون حلول غير رسمية.">
      <a class="btn btn-primary" href={site.signupUrl}>ابدأ حملتك الأولى <svg aria-hidden="true"><use href="#i-arrow" /></svg></a>
    </SectionHead>

    <div class="cb-grid cx" data-step="1">
      <ol class="cx-steps" aria-label="خطوات الحملة">
        {steps.map((s, i) => (
          <li>
            <button type="button" class="cb-step" data-go={i + 1} aria-pressed={i === 0 ? 'true' : 'false'}>
              <i>{i + 1}</i><b>{s.t}</b><span>{s.d}</span>
            </button>
          </li>
        ))}
      </ol>

      <div class="cx-win" aria-hidden="true">
        <div class="cx-bar">
          <span class="cx-dots"><i></i><i></i><i></i></span>
          <b>حملة: عرض نهاية الأسبوع</b>
          <span class="cx-state">مسودة</span>
        </div>
        <div class="cx-body">
          <div class="cx-pane">
            <div class="cx-scr" data-scr="1">
              <p class="cx-k">الجمهور</p>
              <div class="cx-card">
                <p class="cx-seg"><svg><use href="#i-users" /></svg>عملاء مهتمون</p>
                <p class="cx-rules"><i>الوسم = عميل مهتم</i><i>آخر تواصل منذ +30 يومًا</i><i>القناة = واتساب</i></p>
              </div>
              <p class="cx-big"><b>312</b><span>جهة اتصال ستستلم الحملة</span></p>
              <p class="cx-mute">استُبعد تلقائيًا 6 ألغوا الاشتراك</p>
            </div>
            <div class="cx-scr" data-scr="2">
              <p class="cx-k">القالب</p>
              <p class="cx-opt on"><i></i><span dir="ltr">weekend_offer</span><em>✓ معتمد</em></p>
              <p class="cx-opt"><i></i><span dir="ltr">appointment_reminder</span><em>✓ معتمد</em></p>
              <p class="cx-opt"><i></i><span dir="ltr">new_arrivals</span><em class="wait">قيد المراجعة</em></p>
              <p class="cx-var"><span>المتغير</span><b dir="ltr">&#123;&#123;1&#125;&#125;</b><span>= اسم العميل</span></p>
            </div>
            <div class="cx-scr" data-scr="3">
              <p class="cx-k">موعد الإرسال</p>
              <p class="cx-opt"><i></i>إرسال الآن</p>
              <p class="cx-opt on"><i></i>جدولة</p>
              <div class="cx-date"><b>الخميس 2 أكتوبر</b><span dir="ltr">6:00 PM</span></div>
              <p class="cx-mute">من رقم الأعمال <span dir="ltr">+20 10 ··· 0000</span></p>
            </div>
            <div class="cx-scr" data-scr="4">
              <p class="cx-k">النتائج <span class="cx-ok">✓ تم الإرسال</span></p>
              <div class="cx-stats">
                <p><b>312</b><span>أُرسلت</span></p>
                <p><b>305</b><span>وصلت</span></p>
                <p><b>241</b><span>قُرئت</span></p>
                <p><b>64</b><span>نقرات</span></p>
              </div>
              <p class="cx-bars"><i style="--w:98%"></i><i style="--w:77%"></i><i style="--w:21%"></i></p>
              <p class="cx-mute">ألغى الاشتراك: 2 · الأرقام مثال</p>
            </div>
          </div>

          <div class="cx-prev">
            <p class="cx-ph"><svg class="c-wa"><use href="#i-wa" /></svg>معاينة على واتساب</p>
            <div class="cx-wall">
              <div class="cx-bub">
                <span class="cx-img"><svg><use href="#i-spark" /></svg>عرض نهاية الأسبوع</span>
                <p>أهلًا <em>منى</em> 🎁 خصم 20% على الاستشارات حتى الأحد. احجزي موعدك الآن.</p>
                <small><span dir="ltr">6:00 PM</span><span class="cx-ticks">✓✓</span></small>
                <span class="cx-btn">احجز الآن</span>
                <span class="cx-btn">إلغاء الاشتراك</span>
              </div>
              <p class="cx-reply">عايزة أحجز يوم السبت</p>
              <p class="cx-inbox"><svg><use href="#i-inbox" /></svg>الرد وصل إلى صندوق الوارد</p>
            </div>
          </div>
        </div>
        <div class="cx-prog"><i></i></div>
      </div>
    </div>

    <ul class="cx-more">
      <li><svg aria-hidden="true"><use href="#i-shield" /></svg><span><b>ربط رسمي عبر Meta</b>ORQO مسجّل كـ Meta Tech Provider.</span></li>
      <li><svg aria-hidden="true"><use href="#i-inbox" /></svg><span><b>الردود في صندوق الوارد</b>يكملها فريقك أو الوكيل الذكي.</span></li>
      <li><svg aria-hidden="true"><use href="#i-users" /></svg><span><b>شرائح بشروط</b>الرسالة المناسبة للعميل المناسب.</span></li>
    </ul>
  </div>
</section>
