---
import { site } from '../../config/site';
import { I } from '../../i18n';
import SectionHead from '../ui/SectionHead.astro';
const { t } = I(Astro);
const p = t.campaigns;
const w = p.win;
const pv = p.preview;
---
<section class="sec camps" id="campaigns" aria-labelledby="cb-title">
  <div class="wrap">
    <SectionHead id="cb-title" layout="split" chip={p.chip} icon="i-wa" title={p.title} accent={p.accent} lead={p.lead}>
      <a class="btn btn-primary" href={site.signupUrl}>{p.cta} <svg aria-hidden="true"><use href="#i-arrow" /></svg></a>
    </SectionHead>

    <div class="cb-grid cx" data-step="1">
      <ol class="cx-steps" aria-label={p.stepsAria}>
        {p.steps.map((s, i) => (
          <li>
            <button type="button" class="cb-step" data-go={i + 1} aria-pressed={i === 0 ? 'true' : 'false'}>
              <i>{i + 1}</i><b>{s.t}</b><span>{s.d}</span>
            </button>
          </li>
        ))}
      </ol>

      <div class="cx-win" aria-hidden="true">
        <div class="cx-bar">
          <span class="cx-dots"><i></i><i></i><i></i></span>
          <b>{w.title}</b>
          <span class="cx-state">{w.draft}</span>
        </div>
        <div class="cx-body">
          <div class="cx-pane">
            <div class="cx-scr" data-scr="1">
              <p class="cx-k">{w.audienceK}</p>
              <div class="cx-card">
                <p class="cx-seg"><svg><use href="#i-users" /></svg>{w.seg}</p>
                <p class="cx-rules"><i>{w.rules[0]}</i><i>{w.rules[1]}</i><i>{w.rules[2]}</i></p>
              </div>
              <p class="cx-big"><b>312</b><span>{w.big}</span></p>
              <p class="cx-mute">{w.excl}</p>
            </div>
            <div class="cx-scr" data-scr="2">
              <p class="cx-k">{w.templateK}</p>
              <p class="cx-opt on"><i></i><span dir="ltr">weekend_offer</span><em>{w.approved}</em></p>
              <p class="cx-opt"><i></i><span dir="ltr">appointment_reminder</span><em>{w.approved}</em></p>
              <p class="cx-opt"><i></i><span dir="ltr">new_arrivals</span><em class="wait">{w.inReview}</em></p>
              <p class="cx-var"><span>{w.varLabel}</span><b dir="ltr">&#123;&#123;1&#125;&#125;</b><span>{w.varEquals}</span></p>
            </div>
            <div class="cx-scr" data-scr="3">
              <p class="cx-k">{w.scheduleK}</p>
              <p class="cx-opt"><i></i>{w.now}</p>
              <p class="cx-opt on"><i></i>{w.schedule}</p>
              <div class="cx-date"><b>{w.date}</b><span dir="ltr">6:00 PM</span></div>
              <p class="cx-mute">{w.fromNum} <span dir="ltr">+20 10 ··· 0000</span></p>
            </div>
            <div class="cx-scr" data-scr="4">
              <p class="cx-k">{w.resultsK} <span class="cx-ok">{w.sentDone}</span></p>
              <div class="cx-stats">
                <p><b>312</b><span>{w.statSent}</span></p>
                <p><b>305</b><span>{w.statDelivered}</span></p>
                <p><b>241</b><span>{w.statRead}</span></p>
                <p><b>64</b><span>{w.statClicks}</span></p>
              </div>
              <p class="cx-bars"><i style="--w:98%"></i><i style="--w:77%"></i><i style="--w:21%"></i></p>
              <p class="cx-mute">{w.unsub}</p>
            </div>
          </div>

          <div class="cx-prev">
            <p class="cx-ph"><svg class="c-wa"><use href="#i-wa" /></svg>{pv.header}</p>
            <div class="cx-wall">
              <div class="cx-bub">
                <span class="cx-img"><svg><use href="#i-spark" /></svg>{pv.imgCap}</span>
                <p set:html={pv.body} />
                <small><span dir="ltr">6:00 PM</span><span class="cx-ticks">✓✓</span></small>
                <span class="cx-btn">{pv.btnBook}</span>
                <span class="cx-btn">{pv.btnUnsub}</span>
              </div>
              <p class="cx-reply">{pv.reply}</p>
              <p class="cx-inbox"><svg><use href="#i-inbox" /></svg>{pv.inboxNote}</p>
            </div>
          </div>
        </div>
        <div class="cx-prog"><i></i></div>
      </div>
    </div>

    <ul class="cx-more">
      {p.more.map((item) => (
        <li><svg aria-hidden="true"><use href="#i-shield" /></svg><span><b>{item.b}</b>{item.s}</span></li>
      ))}
    </ul>
  </div>
</section>
