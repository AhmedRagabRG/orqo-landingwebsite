---
import { I } from '../../i18n';
import SectionHead from '../ui/SectionHead.astro';
import CtaPair from '../ui/CtaPair.astro';
const { t } = I(Astro);
const m = t.mock;
const c = t.problems.cards;
---
<section class="sec probs" id="problem" aria-labelledby="probs-title">
  <div class="wrap">
    <SectionHead id="probs-title" chip={t.problems.chip} icon="i-inbox" title={t.problems.title} accent={t.problems.accent} lead={t.problems.lead} />

    <div class="pgrid">
      <article class="pcardx pc-wide">
        <p class="pc-tag t-ai"><svg aria-hidden="true"><use href="#i-bot" /></svg>{c.ai.tag}</p>
        <h3>{c.ai.h}</h3>
        <p class="pc-ans"><span aria-hidden="true">↩</span>{c.ai.ans}</p>
        <div class="fv fv-ai pc-vis" aria-hidden="true">
          <p class="ai-in">{c.ai.in}</p>
          <p class="ai-out">{c.ai.out}</p>
          <p class="ai-acts"><i>{c.ai.acts[0]}</i><i>{c.ai.acts[1]}</i><i>{c.ai.acts[2]}</i></p>
        </div>
      </article>

      <article class="pcardx">
        <p class="pc-tag t-inbox"><svg aria-hidden="true"><use href="#i-inbox" /></svg>{c.inbox.tag}</p>
        <h3>{c.inbox.h}</h3>
        <p class="pc-ans"><span aria-hidden="true">↩</span>{c.inbox.ans}</p>
        <div class="fv fv-inbox pc-vis" aria-hidden="true">
          <p><svg class="c-wa"><use href="#i-wa" /></svg><b>{m.monaShort}</b><span>{m.consultQ}</span><i class="own-ai">AI</i></p>
          <p><svg class="c-ig"><use href="#i-ig" /></svg><b>{m.salmaShort}</b><span>{m.availQ}</span><i>Ahmed</i></p>
          <p><svg class="c-ms"><use href="#i-ms" /></svg><b>{m.karimShort}</b><span>{m.pkgQ}</span><i>{m.sarah}</i></p>
        </div>
      </article>

      <article class="pcardx">
        <p class="pc-tag t-crm"><svg aria-hidden="true"><use href="#i-user" /></svg>CRM</p>
        <h3>{c.crm.h}</h3>
        <p class="pc-ans"><span aria-hidden="true">↩</span>{c.crm.ans}</p>
        <div class="fv pc-vis" aria-hidden="true">
          <div class="crm-card">
            <p class="crm-h"><span class="crm-av">{m.ahmedInitial}</span><span><b>{m.ahmedSamy}</b><small dir="ltr">{m.phone}</small></span><svg class="c-wa"><use href="#i-wa" /></svg></p>
            <dl><div><dt>{m.cityLabel}</dt><dd>{m.city}</dd></div><div><dt>{m.interestLabel}</dt><dd>{m.interest}</dd></div></dl>
            <p class="crm-tags"><i>{m.tag}</i><i>{m.vip}</i></p>
          </div>
        </div>
      </article>

      <article class="pcardx pc-wide">
        <p class="pc-tag t-camp"><svg aria-hidden="true"><use href="#i-send" /></svg>{c.camp.tag}</p>
        <h3>{c.camp.h}</h3>
        <p class="pc-ans"><span aria-hidden="true">↩</span>{c.camp.ans}</p>
        <div class="fv fv-camp pc-vis" aria-hidden="true">
          <div class="camp-msg">
            <p class="cm-top"><svg class="c-wa"><use href="#i-wa" /></svg>{m.campTitle} <small>{m.campTo}</small></p>
            <p>{m.campBody}</p>
          </div>
          <div class="camp-bars">
            <p><span>{m.sent}</span><i style="--w:100%"></i><b>4,231</b></p>
            <p><span>{m.delivered}</span><i style="--w:96%"></i><b>4,062</b></p>
            <p><span>{m.read}</span><i style="--w:71%"></i><b>3,004</b></p>
          </div>
        </div>
      </article>

      <article class="pcardx pc-wide">
        <p class="pc-tag t-rep"><svg aria-hidden="true"><use href="#i-chart" /></svg>{c.rep.tag}</p>
        <h3>{c.rep.h}</h3>
        <p class="pc-ans"><span aria-hidden="true">↩</span>{c.rep.ans}</p>
        <div class="fv fv-rep pc-vis" aria-hidden="true">
          <div class="rp-k"><small>{m.firstReply}</small><b>4:12 <span>{m.minutes}</span></b></div>
          <div class="rp-k"><small>{m.resolved}</small><b>1,097</b></div>
          <div class="rp-bars"><i style="--h:45%"></i><i style="--h:58%"></i><i style="--h:50%"></i><i style="--h:70%"></i><i style="--h:64%"></i><i style="--h:82%"></i><i class="last" style="--h:94%"></i></div>
        </div>
      </article>

      <article class="pcardx">
        <p class="pc-tag t-team"><svg aria-hidden="true"><use href="#i-users" /></svg>{c.team.tag}</p>
        <h3>{c.team.h}</h3>
        <p class="pc-ans"><span aria-hidden="true">↩</span>{c.team.ans}</p>
        <div class="fv fv-team pc-vis" aria-hidden="true">
          <span class="tm-core"><svg><use href="#i-inbox" /></svg></span>
          <span class="tm tm-1" lang="en">AR</span><span class="tm tm-2">{m.salmaInitial}</span><span class="tm tm-3">{m.karimInitial}</span><span class="tm tm-4 tm-ai"><svg><use href="#i-bot" /></svg></span>
        </div>
      </article>
    </div>

    <CtaPair />
    <p class="probs-more">{t.problems.more}<svg aria-hidden="true"><use href="#i-chev" /></svg></p>
  </div>
</section>
