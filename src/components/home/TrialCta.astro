---
import CtaPair from '../ui/CtaPair.astro';
---
<section class="trial-band" aria-labelledby="trial-title">
  <div class="wrap trial-inner">
    <div class="trial-float tf-a" aria-hidden="true">
      <p class="tf-h"><svg><use href="#i-spark" /></svg>إجراءات الوكيل الذكي</p>
      <p class="tf-row"><i>✓</i>سجّل بيانات عميل جديد</p>
      <p class="tf-row"><i>✓</i>نقل 3 عملاء إلى Qualified</p>
      <p class="tf-row"><i>✓</i>حوّل محادثة لفريق المبيعات</p>
    </div>
    <div class="trial-copy">
      <h2 id="trial-title" class="trial-t">ابدأ الآن مجانًا<span>وجهّز أول وكيل ذكي اليوم.</span></h2>
      <p>اربط رقم واتساب، وأضف معلومات شغلك، وادعُ فريقك. والخطة المجانية دائمة.</p>
      <CtaPair />
      <ul class="hc-ticks trial-ticks">
        <li><svg aria-hidden="true"><use href="#i-check" /></svg>خطة مجانية دائمة</li>
        <li><svg aria-hidden="true"><use href="#i-check" /></svg>بدون بطاقة دفع</li>
        <li><svg aria-hidden="true"><use href="#i-check" /></svg>عربي بالكامل</li>
      </ul>
    </div>
    <div class="trial-float tf-b" aria-hidden="true">
      <p class="tf-h"><svg><use href="#i-inbox" /></svg>صندوق الوارد</p>
      <p class="tf-msg"><svg class="c-wa"><use href="#i-wa" /></svg><b>منى</b><span>بكام الاستشارة؟</span></p>
      <p class="tf-msg"><svg class="c-ig"><use href="#i-ig" /></svg><b>سلمى</b><span>لسه متاح؟</span></p>
      <p class="tf-msg"><svg class="c-ms"><use href="#i-ms" /></svg><b>كريم</b><span>الباقة بكام؟</span></p>
    </div>
  </div>
</section>
