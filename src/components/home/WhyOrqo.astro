---
import { I } from '../../i18n';
import SectionHead from '../ui/SectionHead.astro';
import MetaBadge from '../ui/MetaBadge.astro';

const tools = [
  { icon: 'i-shopify', c: 'c-shop', name: 'Shopify' },
  { icon: 'i-woo', c: 'c-woo', name: 'WooCommerce' },
  { img: '/img/easyorders.png', name: 'EasyOrders' },
  { icon: 'i-sheets', c: 'c-sheet', name: 'Google Sheets' },
  { icon: 'i-meet', c: 'c-meet', name: 'Google Meet' },
  { icon: 'i-n8n', c: 'c-n8n', name: 'n8n' },
  { icon: 'i-code', c: '', name: 'API' },
];
const { t, href: lp } = I(Astro);
const p = t.why;
---
<section class="sec why" id="why" aria-labelledby="why-title">
  <div class="wrap">
    <SectionHead id="why-title" layout="split" chip={p.chip} icon="i-shield" title={p.title} accent={p.accent} lead={p.lead} />

    <ul class="wb">
      <li class="wb-c wb-ar">
        <div class="wb-copy">
          <h3>{p.ar.h}</h3>
          <p>{p.ar.p}</p>
        </div>
        <div class="wb-art" aria-hidden="true">
          <span class="wb-glyph">ع</span>
          <p class="wb-b wb-b-in">{p.ar.b1}</p>
          <p class="wb-b wb-b-out">{p.ar.b2}</p>
          <p class="wb-lang"><i class="on">{p.ar.langOn}</i><i lang="en">English</i></p>
        </div>
      </li>

      <li class="wb-c wb-meta">
        <div class="wb-copy">
          <h3>{p.meta.h}</h3>
          <p>{p.meta.p}</p>
        </div>
        <div class="wb-art" aria-hidden="true">
          <svg class="wb-meta-logo"><use href="#i-meta" /></svg>
        </div>
        <MetaBadge size="lg" tone="dark" />
      </li>

      <li class="wb-c wb-tools">
        <div class="wb-copy">
          <h3>{p.tools.h}</h3>
          <p>{p.tools.p}</p>
          <a class="link-arrow" href={lp('/pricing#integrations')}>{p.tools.link} <svg aria-hidden="true"><use href="#i-arrow" /></svg></a>
        </div>
        <div class="wb-hub" aria-hidden="true">
          <span class="wb-core"><svg viewBox="0 0 1117 1075"><use href="#logo-mark" /></svg></span>
          {tools.map((tool, i) => (
            <span class="wb-node" style={`--k:${i}`}>
              {tool.img ? <img src={tool.img} width="20" height="20" alt="" /> : <svg class={tool.c}><use href={`#${tool.icon}`} /></svg>}
              <small lang="en">{tool.name}</small>
            </span>
          ))}
        </div>
      </li>

      <li class="wb-c wb-free">
        <p class="wb-num" dir="ltr">0$</p>
        <h3>{p.free.h}</h3>
        <p>{p.free.p}</p>
      </li>

      <li class="wb-c wb-team">
        <p class="wb-num" dir="ltr">24/7</p>
        <h3>{p.team.h}</h3>
        <p>{p.team.p}</p>
        <p class="wb-hand" aria-hidden="true"><i class="ai" lang="en">AI</i><span></span><i lang="en">AR</i></p>
      </li>

      <li class="wb-c wb-all">
        <div class="wb-copy">
          <h3>{p.all.h}</h3>
          <p>{p.all.p}</p>
        </div>
        <ol class="wb-flow" aria-hidden="true">
          {p.tools.flow.map((f) => <li>{f}</li>)}
        </ol>
      </li>
    </ul>
  </div>
</section>
