---
import { site } from '../../config/site';
import { I } from '../../i18n';
import { getImage } from 'astro:assets';
import inboxBooked from '../../assets/inbox-booked.webp';
import inboxList from '../../assets/inbox-list.webp';
const { t, href: lp } = I(Astro);
const desktop = await getImage({ src: inboxBooked, widths: [800, 1200, 1656], format: 'webp' });
const mobile = await getImage({ src: inboxList, width: 354, format: 'webp' });
---
<section class="hero hero-c" aria-labelledby="hero-title">
  <div class="wrap hc-copy">
    <span class="hc-badge"><svg class="mb-logo" aria-hidden="true"><use href="#i-meta"/></svg><b lang="en">Meta Tech Provider</b></span>
    <h1 id="hero-title" class="hc-title">
      <span class="hc-l1">{t.hero.l1}</span>
      <span class="hc-l2">{t.hero.l2pre} <span class="arc-word">{t.hero.arc}<svg class="arc-under" aria-hidden="true"><use href="#arc"/></svg></span>{t.hero.l2post}</span>
    </h1>
    <p class="hc-lead">{t.hero.lead}</p>
    <div class="hc-ctas">
      <a class="btn btn-mint btn-lg" href={site.signupUrl}>{t.ctapair.start} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
      <a class="btn btn-ghost-deep btn-lg" href={lp('/contact')}><svg aria-hidden="true"><use href="#i-meet"/></svg> {t.ctapair.demo}</a>
    </div>
  </div>

  <div class="wrap">
    <figure class="hc-shot">
      <div class="hc-frame">
        <picture>
          <source media="(max-width: 720px)" srcset={mobile.src} width={mobile.attributes.width} height={mobile.attributes.height}>
          <img src={desktop.src} srcset={desktop.srcSet.attribute} sizes="(max-width: 1180px) 92vw, 1100px" width="1656" height="1017" alt={t.hero.alt} fetchpriority="high" decoding="async">
        </picture>
      </div>

      <div class="hc-float hf-wa"><span class="ch-ico"><svg aria-hidden="true"><use href="#i-wa"/></svg></span><span><b>{t.hero.wa.name}</b><small>{t.hero.wa.msg}</small></span></div>
      <div class="hc-float hf-ig"><span class="ch-ico"><svg aria-hidden="true"><use href="#i-ig"/></svg></span><span><b>{t.hero.ig.name}</b><small>{t.hero.ig.msg}</small></span></div>
      <div class="hc-float hf-ms hf-camp"><span class="ch-ico"><svg aria-hidden="true"><use href="#i-send"/></svg></span><span><b>{t.hero.camp.name}</b><small>{t.hero.camp.msg}</small></span></div>
      <div class="hc-float hf-ai"><span class="mini-av av-ai"><svg aria-hidden="true"><use href="#i-bot"/></svg></span><span><b>{t.hero.ai.name}</b><small>{t.hero.ai.msg}</small></span></div>
      <div class="hc-float hf-hand"><span class="f-assign-txt"><s>{t.hero.hand.from}</s><span class="arrow-l">←</span><b lang="en">Ahmed Ragab</b></span></div>
      <div class="hc-float hf-sum"><p class="f-title"><svg aria-hidden="true"><use href="#i-note"/></svg>{t.hero.sum.title}</p><p>{t.hero.sum.body}</p></div>
      <figcaption class="review-tag">{t.hero.review}</figcaption>
    </figure>
  </div>
</section>
