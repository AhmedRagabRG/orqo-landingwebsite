---
import { I } from '../../i18n';
import SectionHead from '../ui/SectionHead.astro';
const { t } = I(Astro);
const p = t.aiPanel;
const s = p.stage;
const tl = p.tiles;
---
<section class="panel-dark ai-panel" id="journey" aria-labelledby="ai-title">
  <div class="wrap">
    <SectionHead id="ai-title" tone="dark" chip={p.chip} title={p.title} accent={p.accent} lead={p.lead} />

    <div class="aitiles">
      <article class="aitile">
        <div class="ait-art g-mint" aria-hidden="true">
          <div class="ait-ui"><p class="mt-in">{tl.reply.in}</p><p class="mt-out">{tl.reply.out}</p><p class="mt-in">{tl.reply.in2}</p></div>
          <span class="ait-pill"><svg><use href="#i-spark" /></svg>{tl.reply.pill}</span>
        </div>
        <h3>{tl.reply.h}</h3>
        <p>{tl.reply.p}</p>
      </article>
      <article class="aitile">
        <div class="ait-art g-sky" aria-hidden="true">
          <div class="ait-ui"><p class="mt-field"><span>{tl.save.name}</span><b>{t.mock.mona}</b><i>✓</i></p><p class="mt-field"><span>{tl.save.phone}</span><b dir="ltr">+20 10 ··· 0000</b><i>✓</i></p><p class="mt-field"><span>{tl.save.email}</span><b>—</b></p></div>
          <span class="ait-pill"><svg><use href="#i-spark" /></svg>{tl.save.pill}</span>
        </div>
        <h3>{tl.save.h}</h3>
        <p>{tl.save.p}</p>
      </article>
      <article class="aitile">
        <div class="ait-art g-teal" aria-hidden="true">
          <div class="ait-ui"><p class="mt-stages"><i>{s.newStage}</i><span>←</span><i class="on" lang="en">Qualified</i><span>←</span><i lang="en">Booked</i></p><p class="mt-tag">{tl.stage.tag}</p></div>
          <span class="ait-pill"><svg><use href="#i-spark" /></svg>{tl.stage.pill}</span>
        </div>
        <h3>{tl.stage.h}</h3>
        <p>{tl.stage.p}</p>
      </article>
      <article class="aitile">
        <div class="ait-art g-sand" aria-hidden="true">
          <div class="ait-ui"><p class="mt-hand"><span class="mt-av mt-ai" lang="en">AI</span><span class="mt-line"></span><span class="mt-av" lang="en">AR</span></p><p class="mt-sys">{tl.handover.sys}</p></div>
          <span class="ait-pill"><svg><use href="#i-spark" /></svg>{tl.handover.pill}</span>
        </div>
        <h3>{tl.handover.h}</h3>
        <p>{tl.handover.p}</p>
      </article>
      <article class="aitile">
        <div class="ait-art g-green" aria-hidden="true">
          <div class="ait-ui"><p class="mt-sum"><b>{tl.summary.sumTitle}</b>{tl.summary.sumBody}</p></div>
          <span class="ait-pill"><svg><use href="#i-spark" /></svg>{tl.summary.pill}</span>
        </div>
        <h3>{tl.summary.h}</h3>
        <p>{tl.summary.p}</p>
      </article>
      <article class="aitile">
        <div class="ait-art g-info" aria-hidden="true">
          <div class="ait-ui"><p class="mt-docs">{tl.knowledge.docs.map((d) => <i>{d}</i>)}</p><p class="mt-out">{tl.knowledge.out}</p></div>
          <span class="ait-pill"><svg><use href="#i-spark" /></svg>{tl.knowledge.pill}</span>
        </div>
        <h3>{tl.knowledge.h}</h3>
        <p>{tl.knowledge.p}</p>
      </article>
    </div>
  </div>
</section>
