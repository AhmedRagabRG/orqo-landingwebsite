---
import { site } from '../../config/site';
import { I } from '../../i18n';
interface Props {
  tone?: 'light' | 'dark';
  note?: string;
}
const { tone = 'light', note } = Astro.props;
const { t, href: lp } = I(Astro);
---
<div class:list={['ctapair', `ctapair-${tone}`]}>
  <div class="ctapair-btns">
    <a class={tone === 'dark' ? 'btn btn-mint btn-lg' : 'btn btn-primary btn-lg'} href={site.signupUrl}>{t.ctapair.start} <svg aria-hidden="true"><use href="#i-arrow" /></svg></a>
    <a class={tone === 'dark' ? 'btn btn-ghost-deep btn-lg' : 'btn btn-ghost btn-lg'} href={lp('/contact')}><svg aria-hidden="true"><use href="#i-meet" /></svg> {t.ctapair.demo}</a>
  </div>
  {note && <p class="ctapair-note">{note}</p>}
</div>
