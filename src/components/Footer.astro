---
import { site } from '../config/site';
import FooterCta from './FooterCta.astro';

interface Props {
  /** Show the closing chat CTA above the links (off on pages that are already a contact point). */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="fx">
  <div class="fx-panel">
    <div class="wrap">
      {cta && <FooterCta />}

      <div class="fx-cols">
        <div class="fx-brand">
          <a href="/" aria-label="ORQO — الصفحة الرئيسية"><svg class="logo" viewBox="0 0 2172 724" aria-hidden="true"><use href="#logo" /></svg></a>
          <p>مساحة عمل واحدة لمحادثات عملائك وفريقك والذكاء الاصطناعي.</p>
        </div>
        <nav class="fx-links" aria-label="روابط التذييل">
          <div><p>المنصة</p><a href="/#journey">الوكيل الذكي</a><a href="/#campaigns">حملات واتساب</a><a href="/#contacts">جهات الاتصال</a><a href="/#automation">الأتمتة</a><a href="/pricing#integrations">التكاملات</a></div>
          <div><p>الشركة</p><a href="/pricing">الأسعار</a><a href="/contact">تواصل معنا</a><a href="/privacy">سياسة الخصوصية</a><a href="/terms">الشروط والأحكام</a></div>
          <div><p>تواصل معنا</p>
            <a href={`mailto:${site.email}`} dir="ltr" class="fx-mail">{site.email}</a>
            <a href={site.whatsappUrl}>واتساب</a>
            <ul class="socials fx-socials" aria-label="حسابات ORQO">
              <li><a href={site.social.facebook} aria-label="فيسبوك"><svg aria-hidden="true"><use href="#i-fb" /></svg></a></li>
              <li><a href={site.social.instagram} aria-label="إنستجرام"><svg aria-hidden="true"><use href="#i-ig" /></svg></a></li>
              <li><a href={site.social.linkedin} aria-label="لينكدإن"><svg aria-hidden="true"><use href="#i-li" /></svg></a></li>
            </ul>
          </div>
        </nav>
      </div>

      <div class="fx-base">
        <p>© {year} <span lang="en">ORQO</span>. جميع الحقوق محفوظة.</p>
        {site.englishUrl && <a class="lang" href={site.englishUrl} hreflang="en" lang="en">English</a>}
      </div>
    </div>
  </div>
</footer>
