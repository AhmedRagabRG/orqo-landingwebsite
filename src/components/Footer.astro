---
import { site } from '../config/site';
import { getLang, getT, href, switchPath } from '../i18n';
import FooterCta from './FooterCta.astro';

interface Props {
  /** Show the closing chat CTA above the links (off on pages that are already a contact point). */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = getT(Astro.currentLocale);
const year = new Date().getFullYear();
const altHref = switchPath(Astro.url.pathname, lang === 'ar' ? 'en' : 'ar');
---
<footer class="fx">
  <div class="fx-panel">
    <div class="wrap">
      {cta && <FooterCta />}

      <div class="fx-cols">
        <div class="fx-brand">
          <a href={href(lang, '/')} aria-label={t.footer.brandAria}><svg class="logo" viewBox="0 0 2172 724" aria-hidden="true"><use href="#logo" /></svg></a>
          <p>{t.footer.tagline}</p>
          <p>{t.footer.founded}</p>
        </div>
        <nav class="fx-links" aria-label={t.footer.navAria}>
          <div><p>{t.footer.platform.title}</p>{t.footer.platform.links.map((l) => <a href={href(lang, l.href)}>{l.label}</a>)}</div>
          <div><p>{t.footer.company.title}</p>{t.footer.company.links.map((l) => <a href={href(lang, l.href)}>{l.label}</a>)}</div>
          <div><p>{t.footer.contactTitle}</p>
            <a href={`mailto:${site.email}`} dir="ltr" class="fx-mail">{site.email}</a>
            <a href={site.whatsappUrl}>{t.footer.whatsapp}</a>
            <ul class="socials fx-socials" aria-label={t.footer.socialsAria}>
              <li><a href={site.social.facebook} aria-label={t.footer.socials.facebook}><svg aria-hidden="true"><use href="#i-fb" /></svg></a></li>
              <li><a href={site.social.instagram} aria-label={t.footer.socials.instagram}><svg aria-hidden="true"><use href="#i-ig" /></svg></a></li>
              <li><a href={site.social.linkedin} aria-label={t.footer.socials.linkedin}><svg aria-hidden="true"><use href="#i-li" /></svg></a></li>
            </ul>
          </div>
        </nav>
      </div>

      <div class="fx-base">
        <p>© {year} <span lang="en">ORQO</span>. {t.footer.rights}</p>
        <a class="lang" href={altHref} hreflang={lang === 'ar' ? 'en' : 'ar'} lang={lang === 'ar' ? 'en' : 'ar'} aria-label={t.footer.switchAria}>{t.footer.switchTo}</a>
      </div>
    </div>
  </div>
</footer>
