---
import { I } from '../../i18n';
import { plans } from '../../data/plans';
import { compare } from '../../data/compare';

const { lang, t } = I(Astro);
const rows = plans[lang];
const groups = compare[lang];
const P = t.pricingPage;
const money = (n: number) => (lang === 'en' ? `$${n}` : `${n}$`);
const cellClass = (v: string) => (v === '✓' ? 'y' : v === '—' ? 'n' : v === P.unlimited ? 'inf' : undefined);
const isUnit = (v: string) => /\d\s?(GB|MB)$/.test(v);
---
<div class="cmp-wrap">
  <table class="cmp" data-show="2">
    <thead>
      <tr>
        <th scope="col"><span class="sr">{P.featureLabel}</span></th>
        {rows.map((p) => (
          <th scope="col" class:list={{ rec: p.recommended }} lang="en">
            {p.name}
            {p.monthly === 0
              ? <small>{money(0)}</small>
              : <small>{money(p.monthly)} {P.perMoShort}</small>}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {groups.map((group) => (
        <>
          <tr class="grp"><th colspan={rows.length + 1} scope="colgroup">{group.title}</th></tr>
          {group.rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((v) => <td class={cellClass(v)}>{isUnit(v) ? <span dir="ltr">{v}</span> : v}</td>)}
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>
</div>
