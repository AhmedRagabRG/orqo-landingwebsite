---
import { plans } from '../../data/plans';
import { compare } from '../../data/compare';

const cellClass = (v: string) => (v === '✓' ? 'y' : v === '—' ? 'n' : v === 'بلا حد' ? 'inf' : undefined);
const isUnit = (v: string) => /\d\s?(GB|MB)$/.test(v);
---
<div class="cmp-wrap">
  <table class="cmp" data-show="2">
    <thead>
      <tr>
        <th scope="col"><span class="sr">الميزة</span></th>
        {plans.map((p) => (
          <th scope="col" class:list={{ rec: p.recommended }} lang="en">
            {p.name}
            {p.monthly === 0
              ? <small>0$</small>
              : <small data-m={`${p.monthly}$ / شهر`} data-y={`${p.yearly}$ / سنة`}>{p.monthly}$ / شهر</small>}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {compare.map((group) => (
        <>
          <tr class="grp"><th colspan={plans.length + 1} scope="colgroup">{group.title}</th></tr>
          {group.rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((v) => <td class={cellClass(v)}>{isUnit(v) ? <span dir="ltr">{v}</span> : v}</td>)}
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>
</div>
