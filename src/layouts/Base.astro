---
import '../styles/landing.css';
import '../styles/site.css';
import '../styles/sections.css';
import { site } from '../config/site';
import { getLang, getT, href, switchPath } from '../i18n';
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReviewToggle from '../components/ReviewToggle.astro';
import PostHog from '../components/PostHog.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Clarity from '../components/Clarity.astro';

interface Props {
  title: string;
  description: string;
  /** Used for page-specific styling (the home header sits on the dark hero). */
  page?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, page, jsonLd, noindex = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = getT(Astro.currentLocale);
const otherLang: 'ar' | 'en' = lang === 'ar' ? 'en' : 'ar';
const cleanPath = Astro.url.pathname.replace(/(\.html|\/index\.html)$/, '').replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cleanPath, site.url);
const altPath = new URL(switchPath(Astro.url.pathname, otherLang), site.url);
const ogImage = new URL('/og.png', site.url);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
/** Strings needed by scripts/landing.js at runtime. */
const jsDict = { menuOpen: t.js.menuOpen, menuClose: t.js.menuClose, form: t.js.form, journey: t.js.journey };
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={altPath} />
    {lang === 'ar' && <link rel="alternate" hreflang="x-default" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#054F56" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={t.meta.ogLocaleAlt} />
    <meta property="og:site_name" content="ORQO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/neo-sans-arabic-medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/neo-sans-arabic-regular.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script define:vars={{ jsDict, homePath: href(lang, '/') }} is:inline>
      window.ORQO = { i18n: jsDict, homePath: homePath };
    </script>
    <GoogleAnalytics />
    <Clarity />
    <PostHog />
  </head>
  <body class:list={{ 'review-on': site.showReview }} data-page={page}>
    <Icons />
    <a class="skip" href="#main">{t.meta.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer cta={page !== 'contact' && page !== '404'} />
    {site.showReview && <ReviewToggle />}
    <script>
      import '../scripts/landing.js';
    </script>
  </body>
</html>
