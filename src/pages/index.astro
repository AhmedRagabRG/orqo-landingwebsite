---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Problems from '../components/home/Problems.astro';
import AiPanel from '../components/home/AiPanel.astro';
import CampaignBand from '../components/home/CampaignBand.astro';
import Industries from '../components/home/Industries.astro';
import MetaBanner from '../components/home/MetaBanner.astro';
import TrialCta from '../components/home/TrialCta.astro';
import Tools from '../components/home/Tools.astro';
import CrmPanel from '../components/home/CrmPanel.astro';
import Automation from '../components/home/Automation.astro';
import Integrations from '../components/home/Integrations.astro';
import PricingPreview from '../components/home/PricingPreview.astro';
import Faq from '../components/home/Faq.astro';
import WhyOrqo from '../components/home/WhyOrqo.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ORQO',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  inLanguage: ['ar', 'en'],
  description: 'منصة محادثات عملاء تجمع واتساب وإنستجرام وماسنجر مع وكلاء ذكاء اصطناعي وفريق العمل في مساحة واحدة.',
};
---
<Base
  title="ORQO — منصة محادثات العملاء"
  description="ORQO يجمع رسائل واتساب وإنستجرام وماسنجر في مساحة عمل واحدة، مع ملف لكل عميل، وحملات واتساب، وأتمتة، ووكيل ذكاء اصطناعي يرد ويسلّم لفريقك."
  page="home"
  jsonLd={jsonLd}
>
  <Hero />
  <Problems />
  <AiPanel />
  <CampaignBand />
  <Industries />
  <MetaBanner />
  <TrialCta />
  <Tools />
  <CrmPanel />
  <Automation />
  <Integrations />
  <PricingPreview />
  <Faq />
  <WhyOrqo />
</Base>
