---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Problem from '../components/home/Problem.astro';
import Journey from '../components/home/Journey.astro';
import Handoff from '../components/home/Handoff.astro';
import Contacts from '../components/home/Contacts.astro';
import Campaigns from '../components/home/Campaigns.astro';
import Automation from '../components/home/Automation.astro';
import Cod from '../components/home/Cod.astro';
import Pipeline from '../components/home/Pipeline.astro';
import Reports from '../components/home/Reports.astro';
import Industries from '../components/home/Industries.astro';
import Integrations from '../components/home/Integrations.astro';
import Trust from '../components/home/Trust.astro';
import PricingPreview from '../components/home/PricingPreview.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ORQO',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  inLanguage: ['ar', 'en'],
  description: 'منصة محادثات عملاء تجمع واتساب وإنستجرام وماسنجر مع وكلاء ذكاء اصطناعي وفريق العمل في مساحة واحدة.',
};
---
<Base
  title="ORQO — منصة محادثات العملاء"
  description="ORQO يجمع رسائل واتساب وإنستجرام وماسنجر في مساحة عمل واحدة، مع ملف لكل عميل، وحملات واتساب، وأتمتة، ووكيل ذكاء اصطناعي يرد ويسلّم لفريقك."
  page="home"
  jsonLd={jsonLd}
>
  <Hero />
  <Problem />
  <Journey />
  <Handoff />
  <Contacts />
  <Campaigns />
  <Automation />
  <Cod />
  <Pipeline />
  <Reports />
  <Industries />
  <Integrations />
  <Trust />
  <PricingPreview />
  <Faq />
  <FinalCta />
</Base>
