  <PageHero chip="404" icon="i-x" title="هذه الصفحة" accent="غير موجودة." lead="ربما تغيّر الرابط أو حُذفت الصفحة. ارجع للرئيسية أو تواصل معنا.">
    <div class="phero-cta">
      <a class="btn btn-primary btn-lg" href="/">الصفحة الرئيسية</a>
      <a class="btn btn-ghost btn-lg" href="/contact">تواصل معنا</a>
    </div>
  </PageHero>
</Base>
