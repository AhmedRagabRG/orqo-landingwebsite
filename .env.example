# Contact form: URL that receives the form as JSON (POST). An n8n webhook works well.
# Leave empty to show a "not connected yet" notice instead.
PUBLIC_CONTACT_ENDPOINT=

# PostHog web analytics. Paste the project API key from PostHog → Settings → Project.
# Leave empty to disable tracking entirely. Host: US cloud (default) or https://eu.i.posthog.com
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# true = show the orange design-review tags and highlighted placeholders (never in production).
PUBLIC_SHOW_REVIEW=false
