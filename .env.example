# Contact form POSTs {"text"} here. Empty = /api/telegram (the nginx relay below).
PUBLIC_CONTACT_ENDPOINT=

# Runtime env for the nginx container (Coolify): bot from @BotFather, and the chat/channel id
# that receives the messages (a channel id looks like -100…; add the bot as channel admin).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostHog web analytics. Paste the project API key from PostHog → Settings → Project.
# Leave empty to disable tracking entirely. Host: US cloud (default) or https://eu.i.posthog.com
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX) from Google Analytics → Admin → Data streams.
# Leave empty to disable gtag entirely.
PUBLIC_GA_ID=

# Microsoft Clarity project ID (from Clarity → Settings → Projects). Empty disables it.
PUBLIC_CLARITY_ID=

# true = show the orange design-review tags and highlighted placeholders (never in production).
PUBLIC_SHOW_REVIEW=false
